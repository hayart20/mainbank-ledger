<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.10</version>
        <relativePath/>
    </parent>

    <groupId>com.mainbank</groupId>
    <artifactId>mainbank-platform</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>mainbank-platform</name>
    <description>MainBank services: ledger, receipts, notifications, statements and the API gateway</description>

    <modules>
        <module>ledger-service</module>
        <module>receipt-service</module>
        <module>notification-service</module>
        <module>statement-service</module>
        <module>api-gateway</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <java.version>25</java.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven.compiler.proc>full</maven.compiler.proc>
        <openpdf.version>2.0.3</openpdf.version>
        <springdoc.version>2.8.17</springdoc.version>
        <!-- 1.19.x cannot talk to Docker Engine 29+ (min API version bump) -->
        <testcontainers.version>1.21.3</testcontainers.version>
    </properties>

</project>
